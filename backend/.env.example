DATABASE_URL=postgresql://postgres:postgres@localhost:5432/splitbill
JWT_ACCESS_SECRET=replace-with-a-32-char-minimum-secret
JWT_REFRESH_SECRET=replace-with-a-different-32-char-secret
JWT_SECRET=optional-backwards-compatible-access-secret
COOKIE_SECRET=replace-with-a-cookie-secret
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000
SEPAY_TIMESTAMP_TOLERANCE_SECONDS=300
CLOUDINARY_CLOUD_NAME=demo
CLOUDINARY_API_KEY=demo
CLOUDINARY_API_SECRET=demo
BCRYPT_ROUNDS=10
LOG_LEVEL=info
APP_TIMEZONE=Asia/Ho_Chi_Minh
JSON_BODY_LIMIT=1mb
WEBHOOK_BODY_LIMIT=256kb
MAX_IMAGE_SIZE_MB=5
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_WEBHOOK_MAX=100
RATE_LIMIT_WINDOW_MS=60000
